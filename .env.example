# Kiki — complete-trip demo backend
# Copy to .env for local runs. The mock version needs no .env at all (defaults
# below). The "real" (hackathon-qualifying) version sets the LIVE flags + creds.
# NEVER commit a real .env — it is gitignored.

# --- Mock version (default: everything mock) ---
MOCK_MODE=true
PAYMENT_MOCK=true
# Artificial latency (seconds); 0 for tests / local iteration.
MOCK_DELAY_SECONDS=1.5

# --- Real version: flip these flags on (leave off for the mock service) ---
SABRE_FLIGHTS_LIVE=false   # /flights/search -> real Sabre Flight Shop v1 itineraries
SABRE_HOTELS_LIVE=false    # /hotel/adjust -> real Sabre hotels via MCP-Skills
PAYPAL_LIVE=false          # /payment/paypal/* -> real sandbox PayPal

# --- Sabre (CERT / test env) ---
# Simplest: paste a pre-issued hackathon bearer token (carries the PCC attribute
# needed for Flight Shop + MCP hotels). Alternatively use CLIENT_ID/SECRET, but a
# self-minted token may lack the MCP/PCC attribute.
SABRE_ACCESS_TOKEN=
SABRE_CLIENT_ID=
SABRE_CLIENT_SECRET=
SABRE_BASE_URL=https://api-crt.cert.havail.sabre.com      # fares/seasonality REST
SABRE_SHOP_BASE_URL=https://api.cert.platform.sabre.com   # Flight Shop v1
SABRE_MCP_URL=https://mcp2.cert.sabre.com/mcp             # MCP-Skills (hotels)
SABRE_PCC=S5OM

# --- PayPal (sandbox) — from developer.paypal.com, Apps & Credentials → Sandbox ---
# CLIENT_ID is public (used by the UI's JS SDK); SECRET is backend-only.
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CURRENCY=USD

# --- Vocal Bridge — the UI calls our POST /token, we mint from VB with this key.
# Needed on whichever backend the UI's VITE_API_BASE points at (the mock one).
VB_API_KEY=
VB_AGENT_ID=98d6dd19-790c-40af-aeaf-28f53bc64ce4   # KiKi (Maui) agent
VB_TOKEN_URL=https://vocalbridgeai.com/api/v1/token
