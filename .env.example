# Kiki — complete-trip demo backend
# Copy to .env for local runs. The mock version needs no .env at all (defaults
# below). The "real" (hackathon-qualifying) version sets the LIVE flags + creds.
# NEVER commit a real .env — it is gitignored.

# --- Mock version (default: everything mock) ---
MOCK_MODE=true
PAYMENT_MOCK=true
# Artificial latency (seconds); 0 for tests / local iteration.
MOCK_DELAY_SECONDS=1.5

# --- Real version: flip these two flags on (leave off for the mock service) ---
# Only these two sponsor touchpoints go live; everything else stays mock.
SABRE_FLIGHTS_LIVE=false
PAYPAL_LIVE=false

# --- Sabre (CERT / test env) — from developer.sabre.com, your app's credentials ---
SABRE_CLIENT_ID=
SABRE_CLIENT_SECRET=
SABRE_BASE_URL=https://api-crt.cert.havail.sabre.com

# --- PayPal (sandbox) — from developer.paypal.com, Apps & Credentials → Sandbox ---
# CLIENT_ID is public (used by the UI's JS SDK); SECRET is backend-only.
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CURRENCY=USD
