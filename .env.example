# Kiki — complete-trip demo backend
# Copy to .env for local runs. All three have working defaults, so the demo
# runs with no .env at all. No new vars were needed for the Maui scenario —
# the August/October datasets live in backend/mocks/, not in config.

# Serve JSON fixtures from backend/mocks/ instead of calling real Sabre.
# Set to false only once backend/sabre_client.py is implemented (endpoints
# return HTTP 501 until then).
MOCK_MODE=true

# Return a polished fake payment confirmation instead of charging anything.
PAYMENT_MOCK=true

# Artificial latency (seconds) added to every endpoint so voice rehearsals
# match real API timing. Set to 0 for tests and local iteration.
MOCK_DELAY_SECONDS=1.5
